# shellcheck shell=bash

# Permite autocompletar tamén os comandos executados con sudo.
complete -cf sudo

# Engade ao PATH os executables instalados localmente, incluídos os de pipx.
export PATH="$PATH:$HOME/.local/bin"

# Activa o autocompletado dos comandos e opcións de pipx.
eval "$(register-python-argcomplete pipx)"

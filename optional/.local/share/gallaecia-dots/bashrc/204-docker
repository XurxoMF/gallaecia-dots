# `docker exec -it`. Abre unha sesión interactiva dentro do contedor e conserva
# o código de saída; os argumentos posteriores a `--` pasan a `docker exec`.
docker-shell() {
  local shell_command=""
  local original_args=()
  local container

  while (($#)); do
    case "$1" in
      --shell)
        if [ $# -lt 2 ]; then
          warning "Falta o comando despois de --shell."
          return 1
        fi
        shell_command="$2"
        shift
        ;;
      -h|--help)
        _docker_help docker-shell
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-shell --help."
        return 1

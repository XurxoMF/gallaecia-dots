# Lista só redes eliminables, permite selección múltiple e confirma o conxunto
# exacto antes de chamar `docker network rm`. Non presenta as redes internas que
# Docker protexe e non actúa ao cancelar.
docker-network-delete() {
  local original_args=()
  local selection line
  local networks=()
  local selected_networks=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _docker_help docker-network-delete

# Borra contedores seleccionados, cunha confirmación adicional se se forza.
docker-container-delete() {
  local force=false
  local original_args=()
  local containers=()

  while (($#)); do
    case "$1" in
      -f|--force) force=true ;;
      -h|--help)
        _docker_help docker-container-delete
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-container-delete --help."
        return 1
        ;;
    esac
    shift
  done

  _docker_require || return 1
  if $force; then
    mapfile -t containers < <(_docker_select_containers all true "Selecciona contedores para borrar:")
  else
    mapfile -t containers < <(_docker_select_containers stopped true "Selecciona contedores para borrar:")
  fi
  if [ ${#containers[@]} -eq 0 ]; then
    info "Non hai contedores dispoñibles para borrar."
    return 0
  fi

  gum_confirm "Borrar ${#containers[@]} contedor(es) seleccionado(s)?" || return 0
  if $force; then
    gum_confirm "Confirmas o borrado forzado? Os procesos activos deteranse." || return 0
    docker container rm --force "${original_args[@]}" "${containers[@]}"
  else
    docker container rm "${original_args[@]}" "${containers[@]}"
  fi
}


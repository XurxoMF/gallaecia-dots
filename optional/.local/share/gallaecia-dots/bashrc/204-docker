        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-build --help."
        return 1
        ;;
    esac
    shift
  done

  _docker_require || return 1
  # `${valor:-alternativa}` abre o input só cando non se pasou a opción.
  tag="${tag:-$(gum_input --header "Etiqueta da imaxe" --placeholder "usuario/imaxe:latest")}" || return 0
  [ -n "$tag" ] || return 0
  context="${context:-$(gum_input --header "Contexto do build" --placeholder "." --value ".")}" || return 0

# Borra redes personalizadas seleccionadas tras pedir confirmación.
docker-network-delete() {
  local original_args=()
  local selection line
  local networks=()
  local selected_networks=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _docker_help docker-network-delete
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-network-delete --help."
        return 1
        ;;
    esac
    shift
  done
  _docker_require || return 1

  # awk separa por tabuladores e exclúe as tres redes internas de Docker.
  mapfile -t networks < <(
    docker network ls --format '{{.ID}}	{{.Name}}	{{.Driver}}' |
      awk -F '\t' '$2 != "bridge" && $2 != "host" && $2 != "none"'
  )
  if [ ${#networks[@]} -eq 0 ]; then
    info "Non hai redes personalizadas para borrar."
    return 0
  fi

  selection="$(printf '%s\n' "${networks[@]}" |
    gum_filter --no-limit --header "Selecciona redes para borrar:" --placeholder "Filtrar redes...")" || return 0
  [ -n "$selection" ] || return 0
  # Cada liña visible leva máis datos; para borrar consérvase só o primeiro ID.
  while IFS= read -r line; do
    selected_networks+=("${line%%$'\t'*}")
  done <<< "$selection"

  gum_confirm "Borrar ${#selected_networks[@]} rede(s) seleccionada(s)?" || return 0
  docker network rm "${original_args[@]}" "${selected_networks[@]}"
}


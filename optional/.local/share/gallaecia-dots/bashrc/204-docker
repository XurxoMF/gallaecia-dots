# shellcheck shell=bash

# Funcións interactivas opcionais para Docker, Compose e Buildx.

# Mostra a mini guía correspondente a cada comando interactivo de Docker.
_docker_help() {
  case "$1" in
    docker-ps)
      cat <<'EOF'
Uso: docker-ps [COLUMNAS] [-a|--all] [-h|--help] [-- argumentos-docker-ps]

Lista contedores nunha táboa configurable.

  --id, --name, --image, --status, --ports, --created, --labels
                  Engade columnas na orde indicada.
  -a, --all       Inclúe tamén os contedores detidos.
  -- ARGUMENTOS   Reenvía argumentos adicionais a `docker ps`.

Sen columnas mostra nome, imaxe, estado e portos.
Exemplo: docker-ps --all --name --created --status -- --filter label=app=web
EOF
      ;;
    docker-shell)
      cat <<'EOF'
Uso: docker-shell [--shell COMANDO] [-h|--help] [-- argumentos-docker-exec]

Selecciona un contedor activo e abre unha shell interactiva. Detecta bash e
usa sh como alternativa.

  --shell CMD     Forza a shell ou comando que se vai executar.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker exec`.
EOF
      ;;
    docker-attach)
      cat <<'EOF'
Uso: docker-attach [-h|--help] [-- argumentos-docker-attach]

Selecciona un contedor activo e conecta a terminal ao seu proceso principal.
Para separarte sen detelo usa Ctrl-p seguido de Ctrl-q.

  -- ARGUMENTOS   Reenvía opcións adicionais a `docker attach`.
EOF
      ;;
    docker-logs)
      cat <<'EOF'
Uso: docker-logs [-f|--follow] [--tail LIÑAS] [-h|--help] [-- argumentos-docker-logs]

Selecciona un contedor e mostra os seus logs.

  -f, --follow    Mantén os logs abertos.
  --tail N        Mostra as últimas N liñas; por defecto 100.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker logs`.
EOF
      ;;
    docker-container-start|docker-container-stop|docker-container-restart)
      cat <<EOF
Uso: $1 [-h|--help] [-- argumentos-docker]

Selecciona un ou varios contedores e executa a acción indicada polo nome.

  -- ARGUMENTOS   Reenvía opcións adicionais ao comando orixinal.
EOF
      ;;
    docker-container-delete)
      cat <<'EOF'
Uso: docker-container-delete [-f|--force] [-h|--help] [-- argumentos-docker-rm]

Selecciona contedores e pide confirmación antes de borralos.

  -f, --force     Inclúe contedores activos, usa `docker rm --force` e pide
                  unha segunda confirmación.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker container rm`.
EOF
      ;;
    docker-images)
      cat <<'EOF'
Uso: docker-images [-a|--all] [-h|--help] [-- argumentos-docker-images]

Lista imaxes con ID, referencia, tamaño e antigüidade.

  -a, --all       Inclúe imaxes intermedias.
  -- ARGUMENTOS   Reenvía argumentos adicionais a `docker image ls`.
EOF
      ;;
    docker-image-delete)
      cat <<'EOF'
Uso: docker-image-delete [-f|--force] [-h|--help] [-- argumentos-docker-rmi]

Selecciona unha ou varias imaxes e confirma antes de borralas.

  -f, --force     Forza o borrado e require unha segunda confirmación.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker image rm`.
EOF
      ;;
    docker-tag)
      cat <<'EOF'
Uso: docker-tag [-h|--help] [-- argumentos-docker-tag]

Selecciona unha imaxe de orixe e pide a referencia de destino no formato
repositorio[:etiqueta].

  -- ARGUMENTOS   Reenvía opcións adicionais a `docker image tag`.
EOF
      ;;
    docker-networks|docker-volumes)
      cat <<EOF
Uso: $1 [-h|--help] [-- argumentos-docker]

Lista os recursos indicados polo nome do comando.

  -- ARGUMENTOS   Reenvía argumentos adicionais ao comando orixinal.
EOF
      ;;
    docker-network-delete)
      cat <<'EOF'
Uso: docker-network-delete [-h|--help] [-- argumentos-docker-network-rm]

Selecciona redes, excluíndo bridge, host e none, e confirma antes de borralas.

  -- ARGUMENTOS   Reenvía opcións adicionais a `docker network rm`.
EOF
      ;;
    docker-volume-delete)
      cat <<'EOF'
Uso: docker-volume-delete [-h|--help] [-- argumentos-docker-volume-rm]

Selecciona volumes e pide unha dobre confirmación porque poden conter datos.

  -- ARGUMENTOS   Reenvía opcións adicionais a `docker volume rm`.
EOF
      ;;
    compose-ps|compose-up|compose-rebuild|compose-update)
      cat <<EOF
Uso: $1 [-h|--help] [-- argumentos-compose]

Executa a operación de Compose indicada no proxecto do directorio actual.

  -- ARGUMENTOS   Reenvía argumentos adicionais a \`docker compose\`.

compose-up usa modo detached; compose-rebuild reconstrúe antes de iniciar;
compose-update descarga imaxes e volve aplicar o proxecto.
EOF
      ;;
    compose-down)
      cat <<'EOF'
Uso: compose-down [-h|--help] [-- argumentos-compose-down]

Pide confirmación e baixa o proxecto actual sen eliminar volumes.

  -- ARGUMENTOS   Reenvía opcións adicionais a `docker compose down`.
EOF
      ;;
    compose-logs)
      cat <<'EOF'
Uso: compose-logs [-f|--follow] [--tail LIÑAS] [-h|--help] [-- argumentos-compose-logs]

Selecciona un ou varios servizos do proxecto e mostra os seus logs.

  -f, --follow    Mantén os logs abertos.
  --tail N        Mostra as últimas N liñas; por defecto 100.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker compose logs`.
EOF
      ;;
    docker-build)
      cat <<'EOF'
Uso: docker-build [-t|--tag IMAXE] [-C|--context RUTA] [-h|--help] [-- argumentos-buildx]

Constrúe unha imaxe local mediante Buildx e `--load`. Se non se indican,
pide interactivamente a etiqueta e o contexto.

  -t, --tag REF       Referencia da imaxe resultante.
  -C, --context RUTA  Contexto de build; por defecto o directorio actual.
  -- ARGUMENTOS       Reenvía opcións adicionais a `docker buildx build`.
EOF
      ;;
    docker-clean)
      cat <<'EOF'
Uso: docker-clean [-h|--help] [-- argumentos-prune]

Mostra o uso de disco e permite limpar contedores, imaxes, caché, volumes ou
o sistema. Sempre confirma; os volumes requiren unha segunda confirmación.

  -- ARGUMENTOS   Reenvía opcións adicionais ao comando prune escollido.
EOF
      ;;
    docker-login)
      cat <<'EOF'
Uso: docker-login [--server SERVIDOR] [-h|--help] [-- argumentos-docker-login]

Inicia sesión en Docker Hub ou noutro rexistro usando o fluxo seguro de Docker.

  --server HOST   Rexistro alternativo; se se omite usa Docker Hub.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker login`.

Exemplo: docker-login -- --username meu-usuario
EOF
      ;;
    docker-logout)
      cat <<'EOF'
Uso: docker-logout [--server SERVIDOR] [-h|--help] [-- argumentos-docker-logout]

Pide confirmación e pecha a sesión de Docker Hub ou doutro rexistro.

  --server HOST   Rexistro alternativo; se se omite usa Docker Hub.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker logout`.
EOF
      ;;
    docker-search)
      cat <<'EOF'
Uso: docker-search [--term TEXTO] [-h|--help] [-- argumentos-docker-search]

Busca imaxes públicas en Docker Hub.

  --term TEXTO    Termo de busca; se se omite pídese cun input.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker search`.
EOF
      ;;
    docker-pull)
      cat <<'EOF'
Uso: docker-pull [--image REFERENCIA] [-h|--help] [-- argumentos-docker-pull]

Descarga unha imaxe de Docker Hub ou doutro rexistro.

  --image REF     Imaxe que se descargará; se se omite pídese cun input.
  -- ARGUMENTOS   Reenvía opcións adicionais a `docker pull`.
EOF
      ;;
    docker-push)
      cat <<'EOF'
Uso: docker-push [-h|--help] [-- argumentos-docker-push]

Selecciona unha imaxe local etiquetada e súbea ao seu rexistro.

  -- ARGUMENTOS   Reenvía opcións adicionais a `docker push`.
EOF
      ;;
  esac
}

# Comproba que o cliente de Docker está dispoñible no PATH.
_docker_require() {
  if ! has_command docker; then
    warning "Docker non está instalado."
    return 1
  fi
}

# Imprime os IDs seleccionados, un por liña.
_docker_select_containers() {
  local scope="$1"
  local multiple="$2"
  local header="$3"
  local options=()
  local filter_args=()
  local selection line

  # Os templates de Docker separan ID, nome, imaxe e estado con tabuladores.
  case "$scope" in
    running)
      mapfile -t options < <(docker ps --format '{{.ID}}	{{.Names}}	{{.Image}}	{{.Status}}')
      ;;
    stopped)
      mapfile -t options < <(
        docker ps -a --filter status=created --filter status=exited --format \
          '{{.ID}}	{{.Names}}	{{.Image}}	{{.Status}}'
      )
      ;;
    all)
      mapfile -t options < <(docker ps -a --format '{{.ID}}	{{.Names}}	{{.Image}}	{{.Status}}')
      ;;
  esac

  [ ${#options[@]} -gt 0 ] || return 1
  [ "$multiple" = true ] && filter_args+=(--no-limit)

  selection="$(printf '%s\n' "${options[@]}" |
    gum_filter "${filter_args[@]}" --header "$header" --placeholder "Filtrar contedores...")" || return 1
  [ -n "$selection" ] || return 1

  # `%%` retira desde o primeiro tabulador e deixa só o ID do contedor.
  while IFS= read -r line; do
    printf '%s\n' "${line%%$'\t'*}"
  done <<< "$selection"
}

# Imprime as referencias das imaxes seleccionadas ou o ID se non teñen etiqueta.
_docker_select_images() {
  local multiple="$1"
  local header="$2"
  local options=()
  local filter_args=()
  local selection line reference image_id

  mapfile -t options < <(
    docker image ls --format '{{.Repository}}:{{.Tag}}	{{.ID}}	{{.Size}}	{{.CreatedSince}}'
  )
  [ ${#options[@]} -gt 0 ] || return 1
  [ "$multiple" = true ] && filter_args+=(--no-limit)

  selection="$(printf '%s\n' "${options[@]}" |
    gum_filter "${filter_args[@]}" --header "$header" --placeholder "Filtrar imaxes...")" || return 1
  [ -n "$selection" ] || return 1

  # As expansións arredor de `$'\t'` extraen campos separados por tabuladores.
  while IFS= read -r line; do
    reference="${line%%$'\t'*}"
    if [ "$reference" = "<none>:<none>" ]; then
      image_id="${line#*$'\t'}"
      printf '%s\n' "${image_id%%$'\t'*}"
    else
      printf '%s\n' "$reference"
    fi
  done <<< "$selection"
}

# Comproba Docker e valida o proxecto Compose do directorio actual.
_docker_require_compose_project() {
  _docker_require || return 1
  if ! docker compose config --quiet 2> /dev/null; then
    warning "Non se atopou un proxecto de Docker Compose válido neste directorio."
    return 1
  fi
}

# Lista contedores permitindo escoller as columnas e incluír os detidos.
docker-ps() {
  local columns=()
  local all=false
  local original_args=()
  local format separator column

  while (($#)); do
    case "$1" in
      --id) columns+=('{{.ID}}') ;;
      --name) columns+=('{{.Names}}') ;;
      --image) columns+=('{{.Image}}') ;;
      --status) columns+=('{{.Status}}') ;;
      --ports) columns+=('{{.Ports}}') ;;
      --created) columns+=('{{.CreatedAt}}') ;;
      --labels) columns+=('{{.Labels}}') ;;
      -a|--all) all=true ;;
      -h|--help)
        _docker_help docker-ps
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-ps --help."
        return 1
        ;;
    esac
    shift
  done

  _docker_require || return 1
  if [ ${#columns[@]} -eq 0 ]; then
    columns=('{{.Names}}' '{{.Image}}' '{{.Status}}' '{{.Ports}}')
  fi

  # Docker usa templates Go; constrúese unha táboa unindo as columnas con tabs.
  format="table "
  separator=""
  for column in "${columns[@]}"; do
    format+="${separator}${column}"
    separator=$'\t'
  done

  if $all; then
    docker ps -a --format "$format" "${original_args[@]}"
  else
    docker ps --format "$format" "${original_args[@]}"
  fi
}

# Selecciona un contedor activo e abre bash ou sh no seu interior.
docker-shell() {
  local shell_command=""
  local original_args=()
  local container

  while (($#)); do
    case "$1" in
      --shell)
        if [ $# -lt 2 ]; then
          warning "Falta o comando despois de --shell."
          return 1
        fi
        shell_command="$2"
        shift
        ;;
      -h|--help)
        _docker_help docker-shell
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-shell --help."
        return 1
        ;;
    esac
    shift
  done

  _docker_require || return 1
  if ! container="$(_docker_select_containers running false "Selecciona un contedor:")"; then
    info "Non hai contedores activos."
    return 0
  fi

  if [ -z "$shell_command" ]; then
    if docker exec "$container" sh -c 'command -v bash' &> /dev/null; then
      shell_command="bash"
    else
      shell_command="sh"
    fi
  fi

  docker exec -it "${original_args[@]}" "$container" "$shell_command"
}

# Conecta a terminal ao proceso principal dun contedor activo.
docker-attach() {
  local original_args=()
  local container

  while (($#)); do
    case "$1" in
      -h|--help)
        _docker_help docker-attach
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-attach --help."
        return 1
        ;;
    esac
    shift
  done
  _docker_require || return 1

  if ! container="$(_docker_select_containers running false "Selecciona un contedor:")"; then
    info "Non hai contedores activos."
    return 0
  fi
  docker attach "${original_args[@]}" "$container"
}

# Mostra os logs dun contedor, opcionalmente en seguimento continuo.
docker-logs() {
  local follow=false
  local tail_lines=100
  local original_args=()
  local container

  while (($#)); do
    case "$1" in
      -f|--follow) follow=true ;;
      --tail)
        if [ $# -lt 2 ]; then
          warning "Falta o número de liñas despois de --tail."
          return 1
        fi
        tail_lines="$2"
        shift
        ;;
      -h|--help)
        _docker_help docker-logs
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-logs --help."
        return 1
        ;;
    esac
    shift
  done

  # A expresión regular acepta unicamente un ou máis díxitos.
  if ! [[ "$tail_lines" =~ ^[0-9]+$ ]]; then
    warning "--tail debe recibir un número enteiro."
    return 1
  fi
  _docker_require || return 1

  if ! container="$(_docker_select_containers all false "Selecciona un contedor:")"; then
    info "Non hai contedores."
    return 0
  fi

  local args=(logs --tail "$tail_lines")
  $follow && args+=(--follow)
  docker "${args[@]}" "${original_args[@]}" "$container"
}

# Reutiliza o selector múltiple para iniciar, deter ou reiniciar contedores.
_docker_container_action() {
  local action="$1"
  local scope="$2"
  shift 2
  local containers=()

  mapfile -t containers < <(_docker_select_containers "$scope" true "Selecciona contedores para $action:")
  if [ ${#containers[@]} -eq 0 ]; then
    info "Non hai contedores dispoñibles para esta acción."
    return 0
  fi

  docker container "$action" "$@" "${containers[@]}"
}


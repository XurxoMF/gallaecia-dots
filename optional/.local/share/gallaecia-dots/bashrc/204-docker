# Mostra os logs dos servizos de Compose seleccionados.
compose-logs() {
  local follow=false
  local tail_lines=100
  local original_args=()
  local selection service
  local services=()
  local selected_services=()

  while (($#)); do
    case "$1" in
      -f|--follow) follow=true ;;
      --tail)
        if [ $# -lt 2 ]; then
          warning "Falta o número de liñas despois de --tail."
          return 1
        fi
        tail_lines="$2"
        shift
        ;;
      -h|--help)
        _docker_help compose-logs
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa compose-logs --help."
        return 1
        ;;
    esac
    shift
  done

  # A expresión regular evita enviar valores non numéricos a `--tail`.
  if ! [[ "$tail_lines" =~ ^[0-9]+$ ]]; then
    warning "--tail debe recibir un número enteiro."
    return 1
  fi
  _docker_require_compose_project || return 1
  mapfile -t services < <(docker compose config --services)
  [ ${#services[@]} -gt 0 ] || return 0

  # O bloque agrupa a opción global e os servizos nunha soa entrada para gum.
  selection="$(
    {
      printf '%s\n' "Todos os servizos"
      printf '%s\n' "${services[@]}"
    } | gum_filter --no-limit --header "Selecciona servizos:" --placeholder "Filtrar servizos..."
  )" || return 0
  [ -n "$selection" ] || return 0

  if ! grep -qxF "Todos os servizos" <<< "$selection"; then
    while IFS= read -r service; do
      selected_services+=("$service")
    done <<< "$selection"
  fi

  local args=(compose logs --tail "$tail_lines")
  $follow && args+=(--follow)
  docker "${args[@]}" "${original_args[@]}" "${selected_services[@]}"
}


# Comproba que o cliente `docker` pode resolverse no PATH antes de calquera fluxo.
# Non contacta aínda co daemon; devolve 1 cun aviso claro se falta o executable
# para evitar erros menos comprensibles no medio dunha selección interactiva.
_docker_require() {
  if ! has_command docker; then
    warning "Docker non está instalado."
    return 1
  fi
}

# Recibe un filtro de estado e se a selección pode ser múltiple.
# Consulta os contedores, formatea ID/nome/imaxe/estado para Gum e imprime só os
# IDs elixidos, un por liña. Non modifica contedores e cancelar produce saída baleira.
_docker_select_containers() {
  local scope="$1"
  local multiple="$2"
  local header="$3"
  local options=()
  local filter_args=()
  local selection line

  # Os templates de Docker separan ID, nome, imaxe e estado con tabuladores.
  case "$scope" in
    running)
      mapfile -t options < <(docker ps --format '{{.ID}}	{{.Names}}	{{.Image}}	{{.Status}}')
      ;;
    stopped)
      mapfile -t options < <(
        docker ps -a --filter status=created --filter status=exited --format \
          '{{.ID}}	{{.Names}}	{{.Image}}	{{.Status}}'
      )
      ;;
    all)
      mapfile -t options < <(docker ps -a --format '{{.ID}}	{{.Names}}	{{.Image}}	{{.Status}}')
      ;;
  esac

  [ ${#options[@]} -gt 0 ] || return 1
  [ "$multiple" = true ] && filter_args+=(--no-limit)

  selection="$(printf '%s\n' "${options[@]}" |
    gum_filter --header "$header" -- \
      "${filter_args[@]}" --placeholder "Filtrar contedores...")" || return 1
  [ -n "$selection" ] || return 1

  # `%%` retira desde o primeiro tabulador e deixa só o ID do contedor.
  while IFS= read -r line; do
    printf '%s\n' "${line%%$'\t'*}"
  done <<< "$selection"
}

# Recibe se a selección de imaxes é múltiple, lista as imaxes locais con contexto
# humano e pásaas a Gum. Imprime `repositorio:tag` ou, para imaxes sen etiqueta,
# o ID, que os comandos consumidores poden entregar directamente a Docker.
_docker_select_images() {
  local multiple="$1"
  local header="$2"
  local options=()
  local filter_args=()
  local selection line reference image_id

  mapfile -t options < <(
    docker image ls --format '{{.Repository}}:{{.Tag}}	{{.ID}}	{{.Size}}	{{.CreatedSince}}'
  )
  [ ${#options[@]} -gt 0 ] || return 1
  [ "$multiple" = true ] && filter_args+=(--no-limit)

  selection="$(printf '%s\n' "${options[@]}" |
    gum_filter --header "$header" -- \
      "${filter_args[@]}" --placeholder "Filtrar imaxes...")" || return 1
  [ -n "$selection" ] || return 1

  # As expansións arredor de `$'\t'` extraen campos separados por tabuladores.
  while IFS= read -r line; do
    reference="${line%%$'\t'*}"
    if [ "$reference" = "<none>:<none>" ]; then
      image_id="${line#*$'\t'}"
      printf '%s\n' "${image_id%%$'\t'*}"
    else
      printf '%s\n' "$reference"
    fi
  done <<< "$selection"
}


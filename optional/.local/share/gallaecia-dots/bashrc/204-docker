# Selecciona unha imaxe local etiquetada e súbea ao seu rexistro.
docker-push() {
  local original_args=()
  local selection reference
  local images=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _docker_help docker-push
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-push --help."
        return 1
        ;;
    esac
    shift
  done
  _docker_require || return 1

  # awk elimina as imaxes sen repositorio nin etiqueta, que non se poden subir.
  mapfile -t images < <(
    docker image ls --format '{{.Repository}}:{{.Tag}}	{{.ID}}	{{.Size}}' |
      awk -F '\t' '$1 != "<none>:<none>"'
  )
  if [ ${#images[@]} -eq 0 ]; then
    info "Non hai imaxes etiquetadas para subir."
    return 0
  fi

  selection="$(printf '%s\n' "${images[@]}" |
    gum_filter --header "Selecciona unha imaxe para subir:" --placeholder "Filtrar imaxes...")" || return 0
  [ -n "$selection" ] || return 0
  # A referencia que necesita push é o campo anterior ao primeiro tabulador.
  reference="${selection%%$'\t'*}"

  docker push "${original_args[@]}" "$reference"
}

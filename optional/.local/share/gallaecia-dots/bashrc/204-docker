        return 1
        ;;
    esac
    shift
  done
  _docker_require_compose_project || return 1
  docker compose up -d --build "${original_args[@]}"
}

# Executa en orde `docker compose pull` e `docker compose up -d`.
# A segunda fase só se realiza se a descarga remata correctamente; actualiza os
# contedores do proxecto coas imaxes obtidas sen ocultar fallos intermedios.
compose-update() {
  local original_args=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _docker_help compose-update
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa compose-update --help."
        return 1
        ;;
    esac
    shift
  done
  _docker_require_compose_project || return 1
  docker compose pull "${original_args[@]}" &&
    docker compose up -d "${original_args[@]}"
}

# Recibe ou solicita unha etiqueta e un contexto de construción, valida Buildx
# e executa `docker buildx build --load`. Cando falta o contexto, `gum_folder`
# permite escoller un directorio desde a ruta actual. A imaxe resultante queda
# dispoñible no almacén local; os argumentos posteriores a `--` permiten engadir
# build args.
docker-build() {
  local tag=""
  local context=""
  local original_args=()

  while (($#)); do
    case "$1" in
      -t|--tag)
        if [ $# -lt 2 ]; then
          warning "Falta a referencia despois de $1."
          return 1
        fi
        tag="$2"
        shift
        ;;
      -C|--context)
        if [ $# -lt 2 ]; then
          warning "Falta a ruta despois de $1."
          return 1
        fi
        context="$2"
        shift
        ;;
      -h|--help)
        _docker_help docker-build
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-build --help."
        return 1
        ;;
    esac
    shift
  done

  _docker_require || return 1
  # `${valor:-alternativa}` abre o input só cando non se pasou a opción.
  tag="${tag:-$(gum_input --header "Etiqueta da imaxe" -- \
    --placeholder "usuario/imaxe:latest")}" || return 0
  [ -n "$tag" ] || return 0
  context="${context:-$(gum_folder --header "Contexto do build" .)}" || return 0
  [ -n "$context" ] || return 0

  docker buildx build --load --tag "$tag" "${original_args[@]}" "$context"
}

# Mostra tipos de recursos que Docker pode podar e constrúe o comando escollido.
# Explica o alcance e confirma antes de executar calquera `prune`; as variantes
# que poden alcanzar máis datos engaden as opcións só tras a decisión do usuario.
docker-clean() {
  local original_args=()
  local action

  while (($#)); do
    case "$1" in
      -h|--help)
        _docker_help docker-clean
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-clean --help."
        return 1
        ;;
    esac
    shift
  done
  _docker_require || return 1

  docker system df
  action="$(gum_choose --header "Que queres limpar?" \
    "Contedores detidos" "Imaxes sen usar" "Caché de build" \
    "Sistema sen volumes" "Volumes sen usar")" || return 0

  gum_confirm "Executar a limpeza de «$action»?" || return 0
  case "$action" in
    "Contedores detidos")
      docker container prune --force "${original_args[@]}"
      ;;
    "Imaxes sen usar")
      docker image prune --all --force "${original_args[@]}"
      ;;
    "Caché de build")
      docker builder prune --force "${original_args[@]}"
      ;;
    "Sistema sen volumes")
      docker system prune --all --force "${original_args[@]}"
      ;;
    "Volumes sen usar")
      gum_confirm "Confirmas que os datos dos volumes sen usar se poden borrar?" || return 0
      docker volume prune --all --force "${original_args[@]}"
      ;;
  esac
}


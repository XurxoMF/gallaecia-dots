# Selecciona unha imaxe local con referencia publicable e executa `docker push`.
# Transfire as capas ao rexistro indicado pola propia etiqueta; non crea etiquetas
# novas e reenvía opcións como a plataforma ao cliente Docker.
docker-push() {
  local image=""
  local original_args=()
  local selection reference
  local images=()

  while (($#)); do
    case "$1" in
      --image)
        if [ $# -lt 2 ]; then
          warning "Falta a referencia despois de --image."
          return 1
        fi
        image="$2"
        shift
        ;;
      -h|--help)
        _docker_help docker-push
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-push --help."
        return 1
        ;;
    esac
    shift
  done
  _docker_require || return 1

  if [ -z "$image" ]; then
    # awk elimina as imaxes sen repositorio nin etiqueta, que non se poden subir.
    mapfile -t images < <(
      docker image ls --format '{{.Repository}}:{{.Tag}}	{{.ID}}	{{.Size}}' |
        awk -F '\t' '$1 != "<none>:<none>"'
    )
    if [ ${#images[@]} -eq 0 ]; then
      info "Non hai imaxes etiquetadas para subir."
      return 0
    fi

    selection="$(printf '%s\n' "${images[@]}" |
      gum_filter --header "Selecciona unha imaxe para subir:" -- \
        --placeholder "Filtrar imaxes...")" || return 0
    [ -n "$selection" ] || return 0
    # A referencia que necesita push é o campo anterior ao primeiro tabulador.
    reference="${selection%%$'\t'*}"
  else
    reference="$image"
  fi

  docker push "${original_args[@]}" "$reference"
}

# Analiza opcións para incluír contedores detidos e personalizar o formato.
# Executa unha consulta de só lectura con `docker ps`, reenvía os argumentos
# orixinais e imprime a táboa sen iniciar, deter nin borrar recursos.
docker-ps() {
  local columns=()
  local all=false
  local original_args=()
  local format separator column

  while (($#)); do
    case "$1" in
      --id) columns+=('{{.ID}}') ;;
      --name) columns+=('{{.Names}}') ;;
      --image) columns+=('{{.Image}}') ;;
      --status) columns+=('{{.Status}}') ;;
      --ports) columns+=('{{.Ports}}') ;;
      --created) columns+=('{{.CreatedAt}}') ;;
      --labels) columns+=('{{.Labels}}') ;;
      -a|--all) all=true ;;
      -h|--help)
        _docker_help docker-ps
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa docker-ps --help."
        return 1
        ;;
    esac
    shift
  done

  _docker_require || return 1
  if [ ${#columns[@]} -eq 0 ]; then
    columns=('{{.Names}}' '{{.Image}}' '{{.Status}}' '{{.Ports}}')
  fi

  # Docker usa templates Go; constrúese unha táboa unindo as columnas con tabs.
  format="table "
  separator=""
  for column in "${columns[@]}"; do
    format+="${separator}${column}"
    separator=$'\t'
  done

  if $all; then
    docker ps -a --format "$format" "${original_args[@]}"
  else
    docker ps --format "$format" "${original_args[@]}"
  fi
}


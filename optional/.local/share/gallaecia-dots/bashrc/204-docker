# shellcheck shell=bash

# Funcións interactivas opcionais para Docker, Compose e Buildx.

# Recibe o nome dun comando deste módulo e imprime a súa axuda específica.
# Centraliza usos, opcións, controis, efectos e passthrough sen contactar co
# daemon; cada función pública chámaa ao procesar `-h|--help`.

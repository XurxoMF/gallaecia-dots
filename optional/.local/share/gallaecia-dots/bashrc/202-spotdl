# shellcheck shell=bash

# Recibe o nome do wrapper de SpotDL e imprime a súa axuda específica.
# Non inicia interacción nin descarga contido; separa a documentación extensa
# do parser do comando público e permite ampliala se aparecen máis wrappers.
_spotdl_help() {
  case "$1" in
    spotdl-musica)
      cat <<'EOF'
USO
  spotdl-musica [OPCIÓNS] [-- ARGUMENTOS DE SPOTDL DOWNLOAD]

DESCRICIÓN
  Descarga música mediante `spotdl download`. Sen opcións, pide URLs
  repetidamente ata cancelar o input.

OPCIÓNS
  --once
      Pide unha única URL e remata despois da descarga.

  --url URL
      Descarga directamente a URL indicada e implica `--once`.

  -h, --help
      Mostra esta axuda.

  --
      Remata as opcións do wrapper. Todo o posterior reenvíase a
      `spotdl download`.

RESULTADO
  Devolve o código da última execución de SpotDL.
  Cancelar o input sen descargar nada devolve 0.

EXEMPLOS
  spotdl-musica --once
  spotdl-musica --url URL -- --format flac
  spotdl-musica -- --bitrate 320k

COMANDO ORIXINAL
  Para consultar a axuda ou a versión de SpotDL:

  spotdl-musica -- --help
  spotdl-musica -- --version
EOF
      ;;
  esac
}

# Recibe unha URL opcional, un modo dunha soa execución e argumentos adicionais
# para `spotdl download`. Sen URL abre un prompt en bucle ata cancelar; con
# `--url` descarga directamente. A axuda e versión de SpotDL evitan o prompt e
# cada descarga conserva o código do comando orixinal cando o fluxo debe rematar.
spotdl-musica() {
  local once=false
  local url=""
  local original_args=()
  local arg command_status

  while (($#)); do
    case "$1" in
      --once)
        once=true
        ;;
      --url)
        if [ $# -lt 2 ]; then
          warning "Falta a URL despois de --url."
          return 1
        fi
        url="$2"
        once=true
        shift
        ;;
      -h|--help)
        _spotdl_help spotdl-musica
        return 0
        ;;
      --)
        # Todo o posterior pertence a SpotDL e non se interpreta neste wrapper.
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa spotdl-musica --help."
        return 1
        ;;
    esac
    shift
  done

  # Help e versión non precisan URL e deben evitar o bucle interactivo.
  for arg in "${original_args[@]}"; do
    case "$arg" in
      -h|--help)
        spotdl download "${original_args[@]}"
        return
        ;;
      --version)
        spotdl --version
        return
        ;;
    esac
  done

  while true; do
    if [ -z "$url" ]; then
      url="$(gum_input --prompt "URL de Spotify (ou youtube|spotify): " --placeholder "Pega unha URL")" || return 0
    fi

    [ -z "$url" ] && continue

    spotdl download "${original_args[@]}" "$url"
    command_status=$?

    $once && return "$command_status"
    url=""
  done
}

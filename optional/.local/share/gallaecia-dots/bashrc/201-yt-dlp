# shellcheck shell=bash

# Recibe o nome do wrapper de vídeo ou música e imprime a súa axuda específica.
# Centraliza as diferenzas de configuración e exemplos sen executar yt-dlp nin
# iniciar o bucle interactivo; só a chaman os comandos públicos con `--help`.
_yt_dlp_help() {
  case "$1" in
    yt-dlp-video)
      cat <<'EOF'
USO
  yt-dlp-video [OPCIÓNS] [-- ARGUMENTOS DE YT-DLP]

DESCRICIÓN
  Descarga vídeos usando a configuración de YouTube de Gallaecia. Sen opcións,
  pide URLs repetidamente ata cancelar o input.

OPCIÓNS
  --once
      Pide unha única URL e remata despois da descarga.

  --url URL
      Descarga directamente a URL indicada e implica `--once`.

  -h, --help
      Mostra esta axuda.

  --
      Remata as opcións do wrapper. Todo o posterior reenvíase a `yt-dlp`.

RESULTADO
  Devolve o código da última execución de `yt-dlp`.
  Cancelar o input sen descargar nada devolve 0.

EXEMPLOS
  yt-dlp-video --once
  yt-dlp-video --url URL -- --cookies-from-browser firefox
  yt-dlp-video -- --embed-subs --sub-langs gl,es

COMANDO ORIXINAL
  Para consultar todas as opcións admitidas por yt-dlp:

  yt-dlp-video -- --help
EOF
      ;;
    yt-dlp-music)
      cat <<'EOF'
USO
  yt-dlp-music [OPCIÓNS] [-- ARGUMENTOS DE YT-DLP]

DESCRICIÓN
  Descarga música usando a configuración de YouTube Music de Gallaecia. Sen
  opcións, pide URLs repetidamente ata cancelar o input.

OPCIÓNS
  --once
      Pide unha única URL e remata despois da descarga.

  --url URL
      Descarga directamente a URL indicada e implica `--once`.

  -h, --help
      Mostra esta axuda.

  --
      Remata as opcións do wrapper. Todo o posterior reenvíase a `yt-dlp`.

RESULTADO
  Devolve o código da última execución de `yt-dlp`.
  Cancelar o input sen descargar nada devolve 0.

EXEMPLOS
  yt-dlp-music --once
  yt-dlp-music --url URL -- --cookies-from-browser firefox
  yt-dlp-music -- --embed-thumbnail --embed-metadata

COMANDO ORIXINAL
  Para consultar todas as opcións admitidas por yt-dlp:

  yt-dlp-music -- --help
EOF
      ;;
  esac
}

# Recibe unha URL opcional, o modo dunha soa descarga e argumentos para yt-dlp.
# Usa sempre a configuración de vídeo de Gallaecia; sen URL abre repetidamente
# `gum_input` ata cancelar. Executa os argumentos reenviados sen reinterpretalos
# e devolve o estado da descarga cando se usa `--once` ou `--url`.
yt-dlp-video() {
  local once=false
  local url=""
  local original_args=()
  local arg command_status

  while (($#)); do
    case "$1" in
      --once)
        once=true
        ;;
      --url)
        if [ $# -lt 2 ]; then
          warning "Falta a URL despois de --url."
          return 1
        fi
        url="$2"
        once=true
        shift
        ;;
      -h|--help)
        _yt_dlp_help yt-dlp-video
        return 0
        ;;
      --)
        # Todo o posterior pertence a yt-dlp e non se interpreta neste wrapper.
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa yt-dlp-video --help."
        return 1
        ;;
    esac
    shift
  done

  # Help e versión non precisan URL: execútanse directamente e rematan.
  for arg in "${original_args[@]}"; do
    case "$arg" in
      -h|--help|--version)
        yt-dlp \
          --config-location "$HOME/.config/yt-dlp/youtube-com.conf" \
          "${original_args[@]}"
        return
        ;;
    esac
  done

  while true; do
    if [ -z "$url" ]; then
      url="$(gum_input --prompt "URL do vídeo: " --placeholder "Pega unha URL")" || return 0
    fi

    [ -z "$url" ] && continue

    yt-dlp \
      --config-location "$HOME/.config/yt-dlp/youtube-com.conf" \
      "${original_args[@]}" \
      -- "$url"
    command_status=$?

    $once && return "$command_status"
    url=""
  done
}

# Recibe unha URL opcional, o modo dunha soa descarga e argumentos para yt-dlp.
# Usa a configuración musical de Gallaecia, que decide formato e destino; sen
# URL mantén un bucle de `gum_input` ata cancelar. A axuda/versión do programa
# real evita o prompt e o modo dunha soa execución conserva o seu código de saída.
yt-dlp-music() {
  local once=false
  local url=""
  local original_args=()
  local arg command_status

  while (($#)); do
    case "$1" in
      --once)
        once=true
        ;;
      --url)
        if [ $# -lt 2 ]; then
          warning "Falta a URL despois de --url."
          return 1
        fi
        url="$2"
        once=true
        shift
        ;;
      -h|--help)
        _yt_dlp_help yt-dlp-music
        return 0
        ;;
      --)
        # Todo o posterior pertence a yt-dlp e non se interpreta neste wrapper.
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa yt-dlp-music --help."
        return 1
        ;;
    esac
    shift
  done

  # Help e versión non precisan URL: execútanse directamente e rematan.
  for arg in "${original_args[@]}"; do
    case "$arg" in
      -h|--help|--version)
        yt-dlp \
          --config-location "$HOME/.config/yt-dlp/music-youtube-com.conf" \
          "${original_args[@]}"
        return
        ;;
    esac
  done

  while true; do
    if [ -z "$url" ]; then
      url="$(gum_input --prompt "URL da canción: " --placeholder "Pega unha URL")" || return 0
    fi

    [ -z "$url" ] && continue

    yt-dlp \
      --config-location "$HOME/.config/yt-dlp/music-youtube-com.conf" \
      "${original_args[@]}" \
      -- "$url"
    command_status=$?

    $once && return "$command_status"
    url=""
  done
}

# Completa as opcións propias dos dous fluxos de yt-dlp. Tras `--`, Bash aplica
# o completado predeterminado aos argumentos do programa orixinal.
_yt_dlp_completion() {
  local current="${COMP_WORDS[COMP_CWORD]:-}"
  local index

  COMPREPLY=()
  for ((index = 1; index < COMP_CWORD; index++)); do
    if [ "${COMP_WORDS[index]}" = "--" ]; then
      compopt -o default
      return
    fi
  done

  mapfile -t COMPREPLY < <(
    compgen -W "--once --url -h --help --" -- "$current"
  )
}

# Este rexistro só existe cando o Bashrc opcional de yt-dlp está instalado.
if [[ $- == *i* ]]; then
  complete -F _yt_dlp_completion yt-dlp-video yt-dlp-music
fi

# shellcheck shell=bash

# Descarga un vídeo de YouTube usando yt-dlp
yt-dlp-video() {
  while true; do
    echo

    url="$(gum_input --prompt "URL do vídeo: " --placeholder "Pega unha URL")" || return 0

    [ -z "$url" ] && continue

    yt-dlp --config-location "$HOME/.config/yt-dlp/youtube-com.conf" "$@" -- "$url"
  done
}

# Descarga unha canción de YouTube ou YouTube Music usando yt-dlp
yt-dlp-musica() {
  while true; do
    echo
    
    url="$(gum_input --prompt "URL da canción: " --placeholder "Pega unha URL")" || return 0

    [ -z "$url" ] && continue

    yt-dlp --config-location "$HOME/.config/yt-dlp/music-youtube-com.conf" "$@" -- "$url"
  done
}

# shellcheck shell=bash

# Descarga un vídeo de YouTube usando yt-dlp
ytdlp-video() {
  yt-dlp --config-location "$HOME/.config/yt-dlp/youtube-com.conf" "$@"
}

# Descarga unha canción de YouTube ou YouTube Music usando yt-dlp
ytdlp-musica() {
  yt-dlp --config-location "$HOME/.config/yt-dlp/music-youtube-com.conf" "$@"
}

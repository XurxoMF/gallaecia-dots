# Comproba que Git pode resolver a raíz do repositorio desde o directorio actual.
# Non cambia de directorio nin imprime a raíz; devolve 1 cun aviso comprensible
# cando o comando se executa fóra dun worktree.
_git_require_repo() {
  if ! git rev-parse --git-dir &> /dev/null; then
    warning "O directorio actual non pertence a un repositorio Git."
    return 1
  fi
}

# Obtén un historial compacto, móstrao en `choose` e imprime só o hash curto
# da liña seleccionada. Non altera HEAD; a saída está deseñada para capturarse
# desde comandos como `git-diff` e `git-commit-show`.
_git_select_commit() {
  local selection

  # O tabulador separa hash, data e asunto sen confundilos cos espazos do texto.
  selection="$(
    git log --date=short --pretty=format:'%h	%ad	%s' --all |
      filter --header "Selecciona un commit:" -- --placeholder "Filtrar commits..."
  )" || return 1

  [ -n "$selection" ] || return 1
  # `%%` elimina desde o primeiro tabulador ata o final da selección.
  printf '%s\n' "${selection%%$'\t'*}"
}

# Recibe opcionalmente nome, correo e alcance; solicita con Gum os datos ausentes.
# Escribe `user.name` e `user.email` na configuración local ou global de Git e
# valida que o modo local se execute dentro dun repositorio.
git-credentials() {
  local scope=""
  local scope_flag current_name current_email
  local name=""
  local email=""

  while (($#)); do
    case "$1" in
      --name)
        if [ $# -lt 2 ]; then
          warning "Falta o nome despois de --name."
          return 1
        fi
        name="$2"
        shift
        ;;
      --email)
        if [ $# -lt 2 ]; then
          warning "Falta o correo despois de --email."
          return 1
        fi
        email="$2"
        shift
        ;;
      --scope)
        if [ $# -lt 2 ]; then
          warning "Falta o alcance despois de --scope."
          return 1
        fi
        scope="$2"
        shift
        ;;
      -h|--help)
        _git_help git-credentials
        return 0
        ;;
      --)
        shift
        if (($#)); then
          warning "git-credentials non reenvía argumentos a ningún comando orixinal."
          return 1
        fi
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-credentials --help."
        return 1
        ;;
    esac
    shift
  done

  if [ -z "$scope" ]; then
    scope="$(choose --header "Onde queres gardar as credenciais?" \
      "Neste repositorio" "Globalmente")" || return 0
  fi

  case "$scope" in
    local|"Neste repositorio")
      _git_require_repo || return 1
      scope_flag="--local"
      ;;
    global|"Globalmente")
      scope_flag="--global"
      ;;
    *)
      warning "Alcance descoñecido: $scope. Usa local ou global."
      return 1
      ;;
  esac

  if [ -z "$name" ]; then
    current_name="$(git config "$scope_flag" --get user.name 2> /dev/null || true)"
    name="$(input --header "Nome" -- --value "$current_name")" || return 0
  fi

  if [ -z "$name" ]; then
    warning "O nome non pode quedar baleiro."
    return 1
  fi

  if [ -z "$email" ]; then
    current_email="$(git config "$scope_flag" --get user.email 2> /dev/null || true)"
    email="$(input --header "Email" -- --value "$current_email")" || return 0
  fi
  if [ -z "$email" ]; then
    warning "O correo non pode quedar baleiro."
    return 1
  fi

  git config "$scope_flag" user.name "$name" &&
    git config "$scope_flag" user.email "$email" &&
    success "Credenciais de autoría configuradas correctamente."
}

# Recolle o servidor opcional e reenvía argumentos a `gh auth login`.
# Comproba a dependencia, configura o protocolo Git HTTPS e inicia a autenticación
# web; modifica as credenciais que GitHub CLI garda para o usuario.
github-login() {
  local original_args=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help github-login
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa github-login --help."
        return 1
        ;;
    esac
    shift
  done

  if ! has_command gh; then
    warning "GitHub CLI non está instalado. Instala o paquete github-cli."
    return 1
  fi

  gh auth login --web "${original_args[@]}"
}

# Recibe ou solicita a rama inicial e inicializa o directorio indicado, que por
# defecto é o actual. Expande `~`, valida o nome da rama e reenvía as opcións
# posteriores a `--`; pode crear o directorio e a estrutura interna de Git.
git-init() {
  local branch=""
  local directory="$PWD"
  local default_branch
  local original_arg
  local original_args=()

  while (($#)); do
    case "$1" in
      --branch)
        if [ $# -lt 2 ]; then
          warning "Falta RAMA para $1. Usa git-init --help."
          return 1
        fi
        branch="$2"
        shift
        ;;
      --destination)
        if [ $# -lt 2 ]; then
          warning "Falta RUTA para $1. Usa git-init --help."
          return 1
        fi
        directory="$2"
        shift
        ;;
      -h|--help)
        _git_help git-init
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-init --help."
        return 1
        ;;
    esac
    shift
  done

  # A axuda de Git debe funcionar directamente, sen solicitar antes a rama.
  for original_arg in "${original_args[@]}"; do
    case "$original_arg" in
      -h|--help)
        git init "${original_args[@]}"
        return
        ;;
    esac
  done

  if [ -z "$branch" ]; then
    default_branch="$(git config --global --get init.defaultBranch 2> /dev/null || true)"
    branch="$(input --header "Rama inicial" -- \
      --value "${default_branch:-main}")" || return 0
  fi
  if [ -z "$branch" ]; then
    warning "O nome da rama inicial non pode quedar baleiro."
    return 1
  fi
  if ! git check-ref-format --branch "$branch" &> /dev/null; then
    warning "O nome da rama inicial non é válido: $branch"
    return 1
  fi

  # Os valores devoltos por Gum ou recibidos como opción non expanden `~` pola
  # shell, polo que se resolve explicitamente antes de entregar a ruta a Git.
  case "$directory" in
    \~) directory="$HOME" ;;
    \~/*) directory="$HOME/${directory:2}" ;;
  esac

  git init "${original_args[@]}" --initial-branch="$branch" -- "$directory"
}

# Recibe ou solicita a URL e o directorio exacto de destino e executa
# `git clone`. Expande `~` nos valores interactivos ou recibidos por opción,
# reenvía as opcións posteriores a `--` e conserva o código de saída de Git.
git-clone() {
  local repository_url=""
  local directory=""
  local suggested_directory
  local original_arg
  local original_args=()

  while (($#)); do
    case "$1" in
      --url)
        if [ $# -lt 2 ]; then
          warning "Falta URL para $1. Usa git-clone --help."
          return 1
        fi
        repository_url="$2"
        shift
        ;;
      --destination)
        if [ $# -lt 2 ]; then
          warning "Falta RUTA para $1. Usa git-clone --help."
          return 1
        fi
        directory="$2"
        shift
        ;;
      -h|--help)
        _git_help git-clone
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-clone --help."
        return 1
        ;;
    esac
    shift
  done

  # A axuda orixinal non necesita URL nin destino e debe funcionar sen abrir
  # os inputs do wrapper.
  for original_arg in "${original_args[@]}"; do
    case "$original_arg" in
      -h|--help)
        git clone "${original_args[@]}"
        return
        ;;
    esac
  done

  if [ -z "$repository_url" ]; then
    repository_url="$(input --header "URL do repositorio" -- \
      --placeholder "https://github.com/usuario/proxecto.git")" || return 0
  fi
  if [ -z "$repository_url" ]; then
    warning "A URL do repositorio non pode quedar baleira."
    return 1
  fi

  if [ -z "$directory" ]; then
    # Admite URL HTTPS, SSH con ruta e a forma abreviada `usuario@host:ruta`.
    suggested_directory="${repository_url%/}"
    suggested_directory="${suggested_directory##*/}"
    suggested_directory="${suggested_directory##*:}"
    suggested_directory="${suggested_directory%.git}"
    if [ -z "$suggested_directory" ]; then
      suggested_directory="repositorio"
    fi

    directory="$(input --header "Directorio de destino" -- \
      --value "$suggested_directory")" || return 0
  fi
  if [ -z "$directory" ]; then
    warning "O directorio de destino non pode quedar baleiro."
    return 1
  fi

  # As expansións capturadas desde opcións ou Gum non son reinterpretadas pola
  # shell, polo que `~` e `~/...` se resolven explicitamente.
  case "$directory" in
    \~) directory="$HOME" ;;
    \~/*) directory="$HOME/${directory:2}" ;;
  esac

  git clone "${original_args[@]}" -- "$repository_url" "$directory"
}

# Le a saída NUL de `git status --porcelain=v1`, traduce os códigos do índice e
# do worktree a descricións galegas e debuxa unha táboa estática. O formato NUL
# conserva espazos e permite identificar o segundo nome das rutas renomeadas.
git-status() {
  local original_args=()
  local original_arg
  local entry path original_path
  local index_status worktree_status status_text index_text worktree_text
  local index=0
  local entries=()
  local rows=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-status
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-status --help."
        return 1
        ;;
    esac
    shift
  done

  # A axuda orixinal non necesita un repositorio nin debe pasar polo formato
  # tabular propio deste wrapper.
  for original_arg in "${original_args[@]}"; do
    case "$original_arg" in
      -h|--help)
        git status "${original_args[@]}"
        return
        ;;
    esac
  done
  _git_require_repo || return 1

  # A primeira lectura conserva o código de Git, que `mapfile` non pode obter
  # directamente cando recibe os rexistros mediante unha substitución de proceso.
  if ! git status --porcelain=v1 -z "${original_args[@]}" > /dev/null; then
    return 1
  fi
  mapfile -d '' -t entries < <(git status --porcelain=v1 -z "${original_args[@]}")
  while [ $index -lt ${#entries[@]} ]; do
    entry="${entries[index]}"
    index_status="${entry:0:1}"
    worktree_status="${entry:1:1}"
    path="${entry:3}"
    original_path=""

    # No modo `-z`, un renomeado ou copia leva a ruta nova no primeiro rexistro
    # e a ruta orixinal no seguinte, sen os separadores visuais de formato curto.
    if [ "$index_status" = "R" ] || [ "$index_status" = "C" ] ||
      [ "$worktree_status" = "R" ] || [ "$worktree_status" = "C" ]; then
      index=$((index + 1))
      original_path="${entries[index]:-}"
      path="$original_path → $path"
    fi

    case "$index_status$worktree_status" in
      DD|AU|UD|UA|DU|AA|UU)
        status_text="Conflito"
        ;;
      '??')
        status_text="Non rastrexado"
        ;;
      '!!')
        status_text="Ignorado"
        ;;
      *)
        index_text=""
        worktree_text=""
        case "$index_status" in
          A) index_text="Engadido" ;;
          M) index_text="Modificado" ;;
          D) index_text="Eliminado" ;;
          R) index_text="Renomeado" ;;
          C) index_text="Copiado" ;;
          T) index_text="Tipo modificado" ;;
        esac
        case "$worktree_status" in
          A) worktree_text="Engadido" ;;
          M) worktree_text="Modificado" ;;
          D) worktree_text="Eliminado" ;;
          R) worktree_text="Renomeado" ;;
          C) worktree_text="Copiado" ;;
          T) worktree_text="Tipo modificado" ;;
        esac

        if [ -n "$index_text" ] && [ -n "$worktree_text" ]; then
          status_text="Preparado: $index_text · Sen preparar: $worktree_text"
        elif [ -n "$index_text" ]; then
          status_text="Preparado: $index_text"
        else
          status_text="Sen preparar: $worktree_text"
        fi
        ;;
    esac

    # CSV duplica as comiñas internas para conservar nomes de ficheiro literais.
    rows+=("\"${status_text//\"/\"\"}\",\"${path//\"/\"\"}\"")
    index=$((index + 1))
  done

  if [ ${#rows[@]} -eq 0 ]; then
    success "O repositorio está limpo."
    return 0
  fi

  printf '%s\n' 'Estado,Ficheiro' "${rows[@]}" | table -- --print
}

# Permite escoller entre engadir todo, seleccionar ficheiros ou usar o modo patch.
# Constrúe a chamada correspondente a `git add`, reenvía os argumentos posteriores
# a `--` e modifica exclusivamente o índice do repositorio actual.
git-add() {
  local original_args=()
  local mode selection
  local files=()
  local selected_files=()
  local file
  local -A seen_files=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-add
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-add --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  mode="$(choose --header "Como queres preparar os cambios?" \
    "Todos os cambios" "Seleccionar por parches" "Seleccionar ficheiros")" || return 0

  case "$mode" in
    "Todos os cambios")
      git add "${original_args[@]}" --all
      ;;
    "Seleccionar por parches")
      git add "${original_args[@]}" --patch
      ;;
    "Seleccionar ficheiros")
      # Git separa con NUL para admitir rutas con espazos e saltos de liña.
      # O array asociativo evita repetir ficheiros presentes nas dúas listaxes.
      while IFS= read -r -d '' file; do
        if [ -z "${seen_files[$file]+x}" ]; then
          files+=("$file")
          seen_files["$file"]=1
        fi
      done < <(
        git diff --name-only -z
        git ls-files --others --exclude-standard -z
      )

      if [ ${#files[@]} -eq 0 ]; then
        info "Non hai ficheiros sen preparar."
        return 0
      fi

      selection="$(printf '%s\n' "${files[@]}" |
        filter --header "Selecciona ficheiros:" -- \
          --no-limit --placeholder "Filtrar ficheiros...")" || return 0
      [ -n "$selection" ] || return 0
      # Cada liña seleccionada convértese nun elemento independente do array.
      mapfile -t selected_files <<< "$selection"

      git add "${original_args[@]}" -- "${selected_files[@]}"
      ;;
  esac
}

# Recibe ou solicita o título e o corpo dun commit, valida que haxa cambios no
# índice e executa `git commit`. Os argumentos posteriores a `--` pasan a Git e
# o resultado conserva o código do comando orixinal.
git-commit() {
  local original_args=()
  local title=""
  local body=""
  local body_provided=false

  while (($#)); do
    case "$1" in
      --title)
        if [ $# -lt 2 ]; then
          warning "Falta o título despois de --title."
          return 1
        fi
        title="$2"
        shift
        ;;
      --body)
        if [ $# -lt 2 ]; then
          warning "Falta o corpo despois de --body."
          return 1
        fi
        body="$2"
        body_provided=true
        shift
        ;;
      -h|--help)
        _git_help git-commit
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-commit --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  if [ -z "$title" ]; then
    title="$(input --header "Título do commit" -- \
      --placeholder "Describe o cambio brevemente")" || return 0
  fi
  if [ -z "$title" ]; then
    warning "O título do commit non pode quedar baleiro."
    return 1
  fi

  if ! $body_provided; then
    body="$(textarea --header "Corpo opcional do commit" -- \
      --placeholder "Detalles adicionais...")" || return 0
  fi

  if [ -n "$body" ]; then
    git commit "${original_args[@]}" -m "$title" -m "$body"
  else
    git commit "${original_args[@]}" -m "$title"
  fi
}

# Encadea `git-add` e `git-commit` no repositorio actual.
# Só chega ao commit se a preparación remata correctamente; non oculta os erros
# nin duplica a lóxica interactiva dos dous comandos especializados.
git-save() {
  local commit_args=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-save
        return 0
        ;;
      --)
        shift
        commit_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-save --help."
        return 1
        ;;
    esac
    shift
  done

  _git_require_repo || return 1
  git-add -- || return 1

  if git diff --cached --quiet; then
    info "Non hai cambios preparados para gardar."
    return 0
  fi

  git-commit -- "${commit_args[@]}"
}

# Permite seleccionar o ámbito da comparación e constrúe a variante adecuada de
# `git diff` ou `git show`. Só le o repositorio, reenvía opcións de Git e imprime
# o diff resultante sen modificar índice, worktree nin historial.
git-diff() {
  local original_args=()
  local mode commit parent

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-diff
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-diff --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  mode="$(choose --header "Que cambios queres ver?" \
    "Sen preparar" "Preparados" "Dun commit")" || return 0

  case "$mode" in
    "Sen preparar")
      git diff "${original_args[@]}"
      ;;
    "Preparados")
      git diff --cached "${original_args[@]}"
      ;;
    "Dun commit")
      commit="$(_git_select_commit)" || return 0
      # O primeiro commit non ten pai; nese caso compárase coa árbore baleira.
      parent="$(git rev-parse --verify "$commit^" 2> /dev/null || git hash-object -t tree /dev/null)" || return 1
      git diff "${original_args[@]}" "$parent" "$commit"
      ;;
  esac
}

# Executa `git pull --ff-only` para a rama actual e reenvía argumentos adicionais.
# A restrición evita merges implícitos durante o wrapper; modifica o worktree só

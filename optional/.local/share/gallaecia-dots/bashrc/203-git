# Comproba que o directorio actual pertence a un repositorio Git.
_git_require_repo() {
  if ! git rev-parse --git-dir &> /dev/null; then
    warning "O directorio actual non pertence a un repositorio Git."
    return 1
  fi
}

# Permite seleccionar un commit e devolve unicamente o seu hash curto.
_git_select_commit() {
  local selection

  # O tabulador separa hash, data e asunto sen confundilos cos espazos do texto.
  selection="$(
    git log --date=short --pretty=format:'%h	%ad	%s' --all |
      gum_filter --header "Selecciona un commit:" --placeholder "Filtrar commits..."
  )" || return 1

  [ -n "$selection" ] || return 1
  # `%%` elimina desde o primeiro tabulador ata o final da selección.
  printf '%s\n' "${selection%%$'\t'*}"
}

# Configura o nome e o correo de autoría local ou global.
git-credenciales() {
  local scope scope_flag current_name current_email name email

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-credenciales
        return 0
        ;;
      --)
        shift
        if (($#)); then
          warning "git-credenciales non reenvía argumentos a ningún comando orixinal."
          return 1
        fi
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-credenciales --help."
        return 1
        ;;
    esac
    shift
  done

  scope="$(gum_choose --header "Onde queres gardar as credenciais?" \
    "Neste repositorio" "Globalmente")" || return 0

  if [ "$scope" = "Neste repositorio" ]; then
    _git_require_repo || return 1
    scope_flag="--local"
  else
    scope_flag="--global"
  fi

  current_name="$(git config "$scope_flag" --get user.name 2> /dev/null || true)"
  current_email="$(git config "$scope_flag" --get user.email 2> /dev/null || true)"

  name="$(gum_input --header "Nome para os commits" --placeholder "Nome e apelidos" --value "$current_name")" || return 0
  if [ -z "$name" ]; then
    warning "O nome non pode quedar baleiro."
    return 1
  fi

  email="$(gum_input --header "Correo para os commits" --placeholder "usuario@exemplo.gal" --value "$current_email")" || return 0
  if [ -z "$email" ]; then
    warning "O correo non pode quedar baleiro."
    return 1
  fi

  git config "$scope_flag" user.name "$name" &&
    git config "$scope_flag" user.email "$email" &&
    success "Credenciais de autoría configuradas correctamente."
}

# Inicia sesión en GitHub mediante GitHub CLI e o navegador.
github-login() {
  local original_args=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help github-login
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa github-login --help."
        return 1
        ;;
    esac
    shift
  done

  if ! has_command gh; then
    warning "GitHub CLI non está instalado. Instala o paquete github-cli."
    return 1
  fi

  gh auth login --web "${original_args[@]}"
}

# Prepara todos os cambios, parches ou ficheiros seleccionados.
git-add() {
  local original_args=()
  local mode selection
  local files=()
  local selected_files=()
  local file
  local -A seen_files=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-add
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-add --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  mode="$(gum_choose --header "Como queres preparar os cambios?" \
    "Todos os cambios" "Seleccionar por parches" "Seleccionar ficheiros")" || return 0

  case "$mode" in
    "Todos os cambios")
      git add "${original_args[@]}" --all
      ;;
    "Seleccionar por parches")
      git add "${original_args[@]}" --patch
      ;;
    "Seleccionar ficheiros")
      # Git separa con NUL para admitir rutas con espazos e saltos de liña.
      # O array asociativo evita repetir ficheiros presentes nas dúas listaxes.
      while IFS= read -r -d '' file; do
        if [ -z "${seen_files[$file]+x}" ]; then
          files+=("$file")
          seen_files["$file"]=1
        fi
      done < <(
        git diff --name-only -z
        git ls-files --others --exclude-standard -z
      )

      if [ ${#files[@]} -eq 0 ]; then
        info "Non hai ficheiros sen preparar."
        return 0
      fi

      selection="$(printf '%s\n' "${files[@]}" |
        gum_filter --no-limit --header "Selecciona ficheiros:" --placeholder "Filtrar ficheiros...")" || return 0
      [ -n "$selection" ] || return 0
      # Cada liña seleccionada convértese nun elemento independente do array.
      mapfile -t selected_files <<< "$selection"

      git add "${original_args[@]}" -- "${selected_files[@]}"
      ;;
  esac
}

# Crea un commit pedindo un título e un corpo opcional.
git-commit() {
  local original_args=()
  local title body

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-commit
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-commit --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  title="$(gum_input --header "Título do commit" --placeholder "Describe o cambio brevemente")" || return 0
  if [ -z "$title" ]; then
    warning "O título do commit non pode quedar baleiro."
    return 1
  fi

  body="$(gum_write --header "Corpo opcional do commit" --placeholder "Detalles adicionais...")" || return 0

  if [ -n "$body" ]; then
    git commit "${original_args[@]}" -m "$title" -m "$body"
  else
    git commit "${original_args[@]}" -m "$title"
  fi
}

# Prepara cambios interactivamente e crea o commit nun único fluxo.
git-save() {
  local commit_args=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-save
        return 0
        ;;
      --)
        shift
        commit_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-save --help."
        return 1
        ;;
    esac
    shift
  done

  _git_require_repo || return 1
  git-add -- || return 1

  if git diff --cached --quiet; then
    info "Non hai cambios preparados para gardar."
    return 0
  fi

  git-commit -- "${commit_args[@]}"
}

# Mostra cambios sen preparar, preparados ou pertencentes a un commit.
git-diff() {
  local original_args=()
  local mode commit parent

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-diff
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-diff --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  mode="$(gum_choose --header "Que cambios queres ver?" \
    "Sen preparar" "Preparados" "Dun commit")" || return 0

  case "$mode" in
    "Sen preparar")
      git diff "${original_args[@]}"
      ;;
    "Preparados")
      git diff --cached "${original_args[@]}"
      ;;
    "Dun commit")
      commit="$(_git_select_commit)" || return 0
      # O primeiro commit non ten pai; nese caso compárase coa árbore baleira.
      parent="$(git rev-parse --verify "$commit^" 2> /dev/null || git hash-object -t tree /dev/null)" || return 1
      git diff "${original_args[@]}" "$parent" "$commit"
      ;;
  esac
}


}

# Mostra ramas locais distintas da actual, admite selección múltiple e pide unha
# confirmación antes de borrar. O modo forzado require unha confirmación adicional
# porque pode eliminar traballo non integrado; finalmente chama `git branch -d/-D`.
git-branch-delete() {
  local force=false
  local original_args=()
  local current selection branch
  local branches=()
  local selected_branches=()

  while (($#)); do
    case "$1" in
      -f|--force)
        force=true
        ;;
      -h|--help)
        _git_help git-branch-delete
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-branch-delete --help."
        return 1
        ;;
    esac
    shift
  done

  _git_require_repo || return 1
  current="$(git branch --show-current)"
  # `%(refname:short)` elimina o prefixo interno refs/heads/ dos nomes.
  # A rama actual exclúese para impedir que Git tente borrala.
  mapfile -t branches < <(
    git for-each-ref --format='%(refname:short)' refs/heads |
      while IFS= read -r branch; do
        [ "$branch" != "$current" ] && printf '%s\n' "$branch"
      done
  )

  if [ ${#branches[@]} -eq 0 ]; then
    info "Non hai outras ramas locais para borrar."
    return 0
  fi

  selection="$(printf '%s\n' "${branches[@]}" |
    filter --header "Selecciona ramas para borrar:" -- \
      --no-limit --placeholder "Filtrar ramas...")" || return 0
  [ -n "$selection" ] || return 0
  mapfile -t selected_branches <<< "$selection"

  confirm "Borrar ${#selected_branches[@]} rama(s) seleccionada(s)?" || return 0

  if $force; then
    confirm "Confirmas o borrado forzado? Pódense perder commits non fusionados." || return 0
    git branch "${original_args[@]}" -D -- "${selected_branches[@]}"
  else
    git branch "${original_args[@]}" -d -- "${selected_branches[@]}"
  fi
}

# Permite seleccionar unha rama local distinta da actual e executa `git merge`.
# Mostra claramente orixe e destino antes de confirmar, reenvía opcións de Git
# e pode modificar historial e worktree segundo o resultado da integración.
git-branch-merge() {
  local original_args=()
  local current selection branch
  local branches=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-branch-merge
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-branch-merge --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  current="$(git branch --show-current)"
  # A listaxe usa nomes curtos e exclúe a rama que recibirá o merge.
  mapfile -t branches < <(
    git for-each-ref --format='%(refname:short)' refs/heads |
      while IFS= read -r branch; do
        [ "$branch" != "$current" ] && printf '%s\n' "$branch"
      done
  )
  if [ ${#branches[@]} -eq 0 ]; then
    info "Non hai outra rama local para integrar."
    return 0
  fi

  selection="$(printf '%s\n' "${branches[@]}" |
    filter --header "Selecciona a rama para integrar:" -- \
      --placeholder "Filtrar ramas...")" || return 0
  [ -n "$selection" ] || return 0

  confirm "Integrar $selection en $current?" || return 0
  git merge "${original_args[@]}" "$selection"
}


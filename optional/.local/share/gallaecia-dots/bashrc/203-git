        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-branch-new --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  if [ -z "$branch" ]; then
    branch="$(input --header "Nome da rama nova" -- \
      --placeholder "feature/nome-da-rama")" || return 0

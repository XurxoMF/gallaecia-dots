# Recibe ou solicita unha descrición e executa `git stash push`, incluíndo
# opcionalmente ficheiros non rastrexados. Retira cambios do worktree para
# gardalos no stash e reenvía as opcións adicionais a Git.
git-stash-save() {
  local include_untracked=false
  local original_args=()
  local message=""
  local message_provided=false

  while (($#)); do
    case "$1" in
      -u|--include-untracked)
        include_untracked=true
        ;;
      --message)
        if [ $# -lt 2 ]; then
          warning "Falta a descrición despois de --message."
          return 1
        fi
        message="$2"
        message_provided=true
        shift
        ;;
      -h|--help)
        _git_help git-stash-save
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-stash-save --help."
        return 1
        ;;
    esac
    shift
  done

  _git_require_repo || return 1
  if ! $message_provided; then
    message="$(input --header "Descrición opcional do stash" -- \
      --placeholder "Traballo en progreso")" || return 0
  fi

  if $include_untracked; then
    git stash push "${original_args[@]}" --include-untracked -m "${message:-Traballo en progreso}"
  else
    git stash push "${original_args[@]}" -m "${message:-Traballo en progreso}"
  fi
}

# Lista os stashes, permite escoller un e executa `git stash pop`.
# A operación aplica os cambios ao worktree e só elimina a entrada se Git pode
# integrala correctamente; conserva os argumentos e o código do comando real.
git-stash-pop() {
  local original_args=()
  local selection stash
  local stashes=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-stash-pop
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-stash-pop --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  # `%gd` é a referencia do stash e `%gs` a súa descrición, separadas por tab.
  mapfile -t stashes < <(git stash list --format='%gd	%gs')
  if [ ${#stashes[@]} -eq 0 ]; then
    info "Non hai entradas no stash."
    return 0
  fi

  selection="$(printf '%s\n' "${stashes[@]}" |
    filter --header "Selecciona un stash:" -- \
      --placeholder "Filtrar stashes...")" || return 0
  [ -n "$selection" ] || return 0
  # Conserva só a referencia anterior ao primeiro tabulador.
  stash="${selection%%$'\t'*}"

  confirm "Aplicar e retirar $stash da lista?" || return 0
  git stash pop "${original_args[@]}" "$stash"
}

# Completa as opcións propias dos wrappers Git e os valores pechados, como o
# alcance das credenciais. Os argumentos posteriores a `--` pertencen a Git.
_git_completion() {
  local command_name="${COMP_WORDS[0]:-}"
  local current="${COMP_WORDS[COMP_CWORD]:-}"
  local previous=""
  local options=""
  local index

  COMPREPLY=()
  if ((COMP_CWORD > 0)); then
    previous="${COMP_WORDS[COMP_CWORD - 1]}"
  fi

  case "$previous" in
    --scope)
      mapfile -t COMPREPLY < <(compgen -W "local global" -- "$current")
      return
      ;;
    --destination)
      compopt -o filenames
      mapfile -t COMPREPLY < <(compgen -d -- "$current")
      return
      ;;
  esac

  for ((index = 1; index < COMP_CWORD; index++)); do
    if [ "${COMP_WORDS[index]}" = "--" ]; then
      compopt -o default
      return
    fi
  done

  case "$command_name" in
    git-credentials)
      options="--name --email --scope -h --help"
      ;;
    git-init)
      options="--branch --destination -h --help --"
      ;;
    git-clone)
      options="--url --destination -h --help --"
      ;;
    git-commit)
      options="--title --body -h --help --"
      ;;
    git-branch-new)
      options="--branch -h --help --"
      ;;
    git-branch-delete)
      options="-f --force -h --help --"
      ;;
    git-stash-save)
      options="-u --include-untracked --message -h --help --"
      ;;
    github-login|git-status|git-add|git-save|git-diff|git-pull|git-push|git-branch-switch|git-branch-merge|git-log|git-commit-show|git-stash-pop)
      options="-h --help --"
      ;;
  esac

  mapfile -t COMPREPLY < <(compgen -W "$options" -- "$current")
}

# Este rexistro só existe cando o Bashrc opcional de Git está instalado.
if [[ $- == *i* ]]; then
  complete -F _git_completion \
    git-credentials github-login git-init git-clone git-status git-add git-commit git-save \
    git-diff git-pull git-push git-branch-switch git-branch-new \
    git-branch-delete git-branch-merge git-log git-commit-show \
    git-stash-save git-stash-pop
fi

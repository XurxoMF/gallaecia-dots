# Publica a rama actual e configura o upstream cando aínda non existe.
git-push() {
  local original_args=()
  local branch remote selection
  local remotes=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-push
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-push --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  if [ ${#original_args[@]} -gt 0 ]; then
    git push "${original_args[@]}"
    return
  fi

  # `@{upstream}` é a referencia remota asociada á rama actual.
  if git rev-parse --abbrev-ref '@{upstream}' &> /dev/null; then
    git push
    return
  fi

  branch="$(git branch --show-current)"
  if [ -z "$branch" ]; then
    warning "Non se pode publicar desde un HEAD separado."
    return 1
  fi

  mapfile -t remotes < <(git remote)
  if [ ${#remotes[@]} -eq 0 ]; then
    warning "O repositorio non ten ningún remoto configurado."
    return 1
  fi

  selection="$(printf '%s\n' "${remotes[@]}" |
    gum_filter --header "Selecciona o remoto:" --placeholder "Filtrar remotos...")" || return 0
  [ -n "$selection" ] || return 0
  remote="$selection"

  git push -u "$remote" "$branch"
}

# Selecciona unha rama local e cambia a ela.
git-branch-switch() {
  local original_args=()
  local selection
  local branches=()

  while (($#)); do
    case "$1" in
      -h|--help)
        _git_help git-branch-switch
        return 0
        ;;
      --)
        shift
        original_args=("$@")
        break
        ;;
      *)
        warning "Opción descoñecida: $1. Usa git-branch-switch --help."
        return 1
        ;;
    esac
    shift
  done
  _git_require_repo || return 1

  mapfile -t branches < <(git for-each-ref --format='%(refname:short)' refs/heads)
  if [ ${#branches[@]} -eq 0 ]; then
    info "Non hai ramas locais."
    return 0
  fi

  selection="$(printf '%s\n' "${branches[@]}" |
    gum_filter --header "Selecciona unha rama:" --placeholder "Filtrar ramas...")" || return 0
  [ -n "$selection" ] || return 0

  git switch "${original_args[@]}" "$selection"
}

# Crea unha rama local nova e cambia a ela.
git-branch-new() {

#!/usr/bin/env bash

set -u
set -o pipefail

# Plantilla de update persoal.
# Este ficheiro non se executa nunca polo instalador porque non segue o patrón
# numérico `X_X_X.sh` que o entrypoint busca dentro de `updates/`.

VERSION="0.0.0"
DOTFILES_DIR="$HOME/.dotfiles"
MODULES_DIR="$DOTFILES_DIR/.local/share/gallaecia-dots/scripts/modules"
INTERNAL_DIR="$DOTFILES_DIR/.local/share/gallaecia-dots/scripts/internal"

# Todos os updates cargan sempre a API pública e as librarías internas completas.
if [ ! -r "$MODULES_DIR/apps.sh" ] ||
  [ ! -r "$MODULES_DIR/commands.sh" ] ||
  [ ! -r "$MODULES_DIR/files.sh" ] ||
  [ ! -r "$MODULES_DIR/gallaecia.sh" ] ||
  [ ! -r "$MODULES_DIR/network.sh" ] ||
  [ ! -r "$MODULES_DIR/ui.sh" ] ||
  [ ! -r "$INTERNAL_DIR/apps.sh" ] ||
  [ ! -r "$INTERNAL_DIR/versions.sh" ]; then
  echo "Non se atoparon os módulos ou librarías internas en $DOTFILES_DIR." >&2
  exit 1
fi

# shellcheck source=/dev/null
source "$MODULES_DIR/apps.sh"
# shellcheck source=/dev/null
source "$MODULES_DIR/commands.sh"
# shellcheck source=/dev/null
source "$MODULES_DIR/files.sh"
# shellcheck source=/dev/null
source "$MODULES_DIR/gallaecia.sh"
# shellcheck source=/dev/null
source "$MODULES_DIR/network.sh"
# shellcheck source=/dev/null
source "$MODULES_DIR/ui.sh"
# shellcheck source=/dev/null
source "$INTERNAL_DIR/apps.sh"
# shellcheck source=/dev/null
source "$INTERNAL_DIR/versions.sh"

# Modelo dun paso illado da migración: debe modificar unha soa responsabilidade
# e devolver un código que `apply_update` poida comprobar de forma explícita.
apply_example_change() {
  # Substitúe este exemplo pola operación necesaria.
  # replace_file "$DOTFILES_DIR/.bashrc" "$HOME/.bashrc"
  true
}

# Mostra só información visible e suficiente para decidir a confirmación.
# Non debe executar instalacións, copias nin cambios de estado.
show_changelog() {
  title "Update $VERSION"
  info "Cambios que se van aplicar:"
  info "· Describe aquí o primeiro cambio."
  info "· Describe aquí o segundo cambio."
}

# Orquestra todos os pasos con bloques `if ! funcion`; engade aquí cada función
# nova na orde necesaria e devolve 1 inmediatamente se unha queda incompleta.
apply_update() {
  if ! apply_example_change; then
    return 1
  fi
}

# Presenta o changelog, confirma e executa o orquestrador.
# Só un éxito completo permite ao instalador marcar a versión como aplicada.
main() {
  show_changelog

  if ! confirm "Instalar update $VERSION?"; then
    warning "Update $VERSION cancelada."
    exit 1
  fi

  if apply_update; then
    success "Update $VERSION instalada con éxito!"
  else
    fail "Algo fallou ao instalar a update $VERSION."
  fi
}

main "$@"
